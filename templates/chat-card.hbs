<div class="tf-card">
  <header class="tf-card__head">
    <div class="tf-card__title">
      <h3>{{name}}</h3>
      <span class="tf-card__formula">{{formula}}</span>
    </div>
    <span class="tf-coin" aria-label="{{formula}}: {{total}}">{{total}}</span>
  </header>
  {{#if ruler}}
  <div class="tf-ruler" data-pos="{{ruler.pos}}" aria-hidden="true">
    <span class="tf-ruler__min">{{ruler.min}}</span>
    <span class="tf-ruler__track"><span class="tf-ruler__fill"></span></span>
    <span class="tf-ruler__max">{{ruler.max}}</span>
  </div>
  {{/if}}
  {{#each results}}
  <section class="tf-card__result">
    {{#if ../multiple}}<span class="tf-card__range">{{range}}</span>{{/if}}
    {{#if img}}<img class="tf-card__img" src="{{img}}" alt="">{{/if}}
    <div class="tf-card__text">{{{html}}}</div>
  </section>
  {{/each}}
  <footer class="tf-card__actions">
    <button type="button" data-tf-action="reroll"><i class="fa-solid fa-rotate"></i> {{localize "TABLEFORGE.Card.Reroll"}}</button>
    <button type="button" data-tf-action="again"><i class="fa-solid fa-dice-d20"></i> {{localize "TABLEFORGE.Card.Again"}}</button>
    <button type="button" data-tf-action="reveal"><i class="fa-solid fa-eye"></i> {{localize "TABLEFORGE.Card.Reveal"}}</button>
  </footer>
</div>
