<section class="tf-list">
  {{#if empty}}
    <div class="tf-empty">
      {{#if query}}
        <p>{{localize "TABLEFORGE.Library.NothingFound"}}</p>
        <button type="button" data-action="clearSearch">{{localize "TABLEFORGE.Library.ClearSearch"}}</button>
      {{else if hasAny}}
        <p>{{localize "TABLEFORGE.Library.EmptyFolder"}}</p>
      {{else}}
        <p>{{localize "TABLEFORGE.Library.NoTables"}}</p>
        {{#if isGM}}<button type="button" data-action="openImport"><i class="fa-solid fa-file-import"></i> {{localize "TABLEFORGE.Import.Button"}}</button>{{/if}}
      {{/if}}
    </div>
  {{else}}
    <ol class="tf-rows">
      {{#each rows}}
      <li class="tf-row{{#if @first}}{{#if @root.query}} tf-row--top{{/if}}{{/if}}" data-uuid="{{uuid}}">
        <button type="button" class="tf-roll" data-action="roll" data-tooltip="{{localize "TABLEFORGE.Library.Roll"}}" aria-label="{{localize "TABLEFORGE.Library.Roll"}}"><i class="fa-solid fa-dice-d20"></i></button>
        <img class="tf-row__img" src="{{img}}" alt="" loading="lazy">
        <div class="tf-row__main">
          <span class="tf-row__name">{{name}}</span>
          {{#if where}}<span class="tf-row__where">{{where}}</span>{{/if}}
        </div>
        <span class="tf-row__formula">{{formula}}</span>
        <span class="tf-row__count" data-tooltip="{{localize "TABLEFORGE.Library.ResultsCount"}}">{{count}}</span>
        <span class="tf-row__rolls" data-tooltip="{{localize "TABLEFORGE.Library.RollCount"}}">{{#if rollCount}}<i class="fa-solid fa-dice"></i> {{rollCount}}{{/if}}</span>
        <button type="button" class="tf-icon {{#if fav}}tf-fav{{/if}}" data-action="toggleFavorite" data-tooltip="{{localize "TABLEFORGE.Library.Favorite"}}" aria-label="{{localize "TABLEFORGE.Library.Favorite"}}"><i class="{{#if fav}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i></button>
        <button type="button" class="tf-icon" data-action="openSheet" data-tooltip="{{localize "TABLEFORGE.Library.Open"}}" aria-label="{{localize "TABLEFORGE.Library.Open"}}"><i class="fa-solid fa-pen-to-square"></i></button>
      </li>
      {{/each}}
    </ol>
    {{#if truncated}}<p class="tf-more">{{localize "TABLEFORGE.Library.Truncated"}}</p>{{/if}}
  {{/if}}
  <footer class="tf-status">{{localize "TABLEFORGE.Library.Found"}}: {{total}}</footer>
</section>
