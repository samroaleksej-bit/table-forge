<nav class="tf-tree" aria-label="{{localize "TABLEFORGE.Library.Title"}}">
  <ul class="tf-tree__group">
    {{#each specials}}
    <li><a class="tf-node {{#if active}}active{{/if}}" data-action="selectFolder" data-folder="{{id}}" style="--tf-indent: 8px">
      <span class="tf-node__twisty"></span><i class="{{icon}}"></i><span class="tf-node__name">{{label}}</span><span class="tf-count">{{count}}</span>
    </a></li>
    {{/each}}
  </ul>

  <ul class="tf-tree__group" role="tree">
    <li><a class="tf-node tf-node--root {{#if worldRoot.active}}active{{/if}}" data-action="selectFolder" data-folder="root" style="--tf-indent: 8px">
      <span class="tf-node__twisty"></span><i class="fa-solid fa-earth-europe"></i><span class="tf-node__name">{{localize "TABLEFORGE.Library.World"}}</span><span class="tf-count">{{worldRoot.count}}</span>
    </a></li>
    {{#each folders}}
    <li role="treeitem" {{#if hasChildren}}aria-expanded="{{#if expanded}}true{{else}}false{{/if}}"{{/if}}>
      <a class="tf-node {{#if active}}active{{/if}} {{#if onPath}}on-path{{/if}}" data-action="selectFolder" data-folder="{{id}}" style="--tf-indent: {{indent}}px">
        {{#if hasChildren}}
        <span class="tf-node__twisty" data-action="toggleExpand" data-folder="{{id}}" role="button" aria-label="{{localize "TABLEFORGE.Library.Expand"}}"><i class="fa-solid fa-chevron-right"></i></span>
        {{else}}
        <span class="tf-node__twisty"></span>
        {{/if}}
        <i class="fa-solid {{#if expanded}}fa-folder-open{{else}}fa-folder{{/if}} tf-folder-icon" {{#if color}}style="color: {{color}}"{{/if}}></i>
        <span class="tf-node__name">{{name}}</span><span class="tf-count">{{count}}</span>
      </a>
    </li>
    {{/each}}
  </ul>

  {{#if packs.length}}
  <h4>{{localize "TABLEFORGE.Library.Compendiums"}}</h4>
  <ul class="tf-tree__group">
    {{#each packs}}
    <li><a class="tf-node {{#if active}}active{{/if}}" data-action="selectFolder" data-folder="{{id}}" style="--tf-indent: 8px">
      <span class="tf-node__twisty"></span><i class="fa-solid fa-book-atlas"></i><span class="tf-node__name">{{label}}</span><span class="tf-count">{{count}}</span>
    </a></li>
    {{/each}}
  </ul>
  {{/if}}
</nav>
